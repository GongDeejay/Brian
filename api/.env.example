# Brian API 环境变量示例。
# 真实值放在服务器的环境文件或 pm2 ecosystem 配置中，**不要提交到仓库**。

# 监听地址与端口（由 nginx 反代，只监听本机）
HOST=127.0.0.1
PORT=3011

# 数据目录与数据库文件。
# ⚠️ 必须在 rsync 发布目录（/var/www/brian.mplusm.site）之外，
#    否则 CI 的 rsync --delete 会删掉全部受试者数据。
BRIAN_DATA_DIR=/var/www/brian-data
# BRIAN_DB_PATH=/var/www/brian-data/brian.db

# 允许的前端来源（仅本地开发需要；生产同源不必配置）
BRIAN_ALLOWED_ORIGINS=https://brian.mplusm.site,http://localhost:3000,http://localhost:3001

# 登录态有效期（天）
BRIAN_SESSION_TTL_DAYS=30

# 生产必须保持 true：cookie 只在 HTTPS 下发送
BRIAN_COOKIE_SECURE=true

# IP 哈希盐：请改成随机字符串，用于审计与限流时的 IP 脱敏
BRIAN_IP_SALT=please-change-this-to-a-random-string

# 知情同意条款版本；条款内容变更时递增，便于追溯受试者同意的是哪一版
BRIAN_CONSENT_VERSION=2026-09-1

# 是否开放受试者自助注册
BRIAN_OPEN_REGISTRATION=true

# 备份目录（默认在数据目录下的 backups/）
# BRIAN_BACKUP_DIR=/var/www/brian-data/backups

# 每个 IP 每小时的注册上限。
# 实验室/教室通常共用一个 NAT 出口 IP，此值过小会导致整间教室无法注册。
BRIAN_MAX_REGISTRATIONS_PER_IP=30

# 每个 IP 每 15 分钟的登录尝试上限（成功登录会清零）。防爆破用，保持较小值。
BRIAN_MAX_LOGIN_ATTEMPTS_PER_IP=20
